		"@eslint/js": "^10.0.1",
		"eslint": "^10.9.1",
		"eslint-config-wikimedia": "^0.32.4",
		"stylelint": "^17.12.0",
		"stylelint-config-wikimedia": "^0.19.2"
	},
	"overrides": {
		"eslint": "$eslint"
